class Solution {
    public int sortPermutation(int[] nums) {
        int temp = -1;
        if(nums[0] != 0){
            return 0;
        }
        for(int i = 1 ; i < nums.length ; i++){
            if(nums[i] != i){
                if(temp == -1){
                    temp = nums[i] & i;
                }else{
                    temp = temp & nums[i] & i;
                }
                
            }
        }
        return temp == -1 ? 0 : temp;
    }
}
