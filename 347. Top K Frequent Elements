class Solution {
    public int[] topKFrequent(int[] nums, int k) {
        int[] res = new int[k];
        HashMap<Integer, Integer> map = new HashMap<>();

        for(int i = 0; i < nums.length ; i++){
            if(map.containsKey(nums[i])){
                map.put(nums[i], map.get(nums[i]) + 1);
            }
            else{
                map.put(nums[i], 1);
            }
        }

       for(int j = 0; j < k ; j++){
        int max = 0;
        int val = 0;
        for(int num :  map.keySet()){
            if(max < map.get(num)){
                max = map.get(num);
                val = num;
            }
        }
        
        res[j] = val;
        map.put(val, 0);
        
       }
    return res;

    }
}
