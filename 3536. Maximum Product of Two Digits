class Solution {
    public int maxProduct(int n) {
        int largest = 0;
        int sl = 0;
        
        while(n > 0){
            int digit = n % 10;

            if(digit > largest){
                sl = largest;
                largest = digit;
            }else if(digit > sl){
                sl = digit;
            }
            n = n / 10;
        }
        return largest * sl;
    }
}
