/**
 * Definition for singly-linked list.
 * class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) {
 *         val = x;
 *         next = null;
 *     }
 * }
 */
public class Solution {
    public ListNode detectCycle(ListNode head) {
        HashSet<ListNode> map = new HashSet<>();

        ListNode slow = head;
        int i = 0;

        while(slow != null ){

            
            if(map.contains(slow)){
                return slow;
            }

            map.add(slow);
            slow = slow.next;

        }
        return null;
    }
}
