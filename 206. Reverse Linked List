
class Solution {
    public ListNode reverseList(ListNode head) {
        ListNode temp = head;
        
        ListNode newone;
        ListNode previous = null;

        while(temp != null){
            newone = temp.next;
            temp.next = previous;
            previous = temp;
            temp = newone;
        }
        head = previous;
        return head;
    }
}


class Solution {
    public ListNode reverseList(ListNode head) {
        ListNode previous = new ListNode();
        ListNode current = new ListNode();
        ListNode trans = new ListNode();

        if(head == null){
            return null;
        }

        previous = null;
        current = head;
        trans = current.next;

        while(trans != null){
            current.next = previous;
            previous = current;
            current = trans;
            trans = trans.next;
        }
        current.next = previous;        
        return current;
    }
}




class Solution {
    public ListNode reverseList(ListNode head) {
        ListNode temp = head;
        Stack<Integer> stack = new Stack<>();

        while(temp != null){
            stack.push(temp.val);
            temp = temp.next;
        }

        temp = head;

        while(temp != null){
            temp.val = stack.pop();
            temp = temp.next;
        }
        return head;
    }
}


