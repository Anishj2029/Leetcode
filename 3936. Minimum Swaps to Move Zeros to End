class Solution {
    public int minimumSwaps(int[] nums) {
        int l = 0;
        int r = nums.length - 1;
        int count = 0;

        while(l < r){
            if(nums[r] == 0){
                r--;
            }
            
            if(nums[r] != 0 && nums[l] == 0){
                int temp = nums[r];
                nums[r] = nums[l];
                nums[l] = temp;
                count += 1;
                r--;
            }
            if(nums[l] != 0){
                l++;
            }

        }
        return count;
    }
}
