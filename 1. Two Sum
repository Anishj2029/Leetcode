class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        unordered_map<int, int> mp;
        int n = nums.size();

        for(int i = 0; i < n; i++){
            mp.insert({nums[i], i});
        }

        for(int i = 0; i < n; i++){
            int sum = target - nums[i];
             if(auto it = mp.find(sum);it != mp.end()  && it->second != i){
                return {i, it->second};
            }
        }
        return {};
    }
};

class Solution {
    public int[] twoSum(int[] nums, int target) {
        int[] res = new int[2];
        int sum = 0;

        for(int i = 0; i < nums.length ; i++){
            sum = target - nums[i];
            int j = i + 1;
            while(j < nums.length){
                if(nums[j] == sum){
                    res[0] = i;
                    res[1] = j;
                }
                j++;
            }
        }
        return res;
    }
}
