class Solution {
    public int removeDuplicates(int[] nums) {
        int slow = 0;
		int count = 1;
		
		for(int fast = 0; fast < nums.length; fast++){
		    if(nums[slow] < nums[fast]){
		        slow = slow + 1;
		        nums[slow] = nums[fast];
		        count = count + 1;
		    }
		    
		}
        return count;
    }
}

class Solution {
    public int removeDuplicates(int[] nums) {
      
        int i = 0;

        for (int j = 1; j < nums.length; j++) {

            if (nums[j] != nums[i]) {
                i++;
                nums[i] = nums[j];
            }
        }

        return i + 1;
    }
}

class Solution {
    public int removeDuplicates(int[] nums) {
      
        HashSet<Integer> set = new HashSet<>();

        int i = 0;
        int count = 1;

        set.add(nums[0]);

        for (int j = 1; j < nums.length; j++) {

            if (!set.contains(nums[j])) {

                set.add(nums[j]);

                i++;

                int temp = nums[i];
                nums[i] = nums[j];
                nums[j] = temp;

                count++;
            }
        }

        return count;
    }
}
