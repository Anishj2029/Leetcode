import java.util.HashSet;
public class Main
{
	public static void main(String[] args) {
		int[] A = {1,2,2,3};
		int[] B = {2,3,4,4};
		HashSet<Integer> res = new HashSet<>();
		int i = 0;
		int j = 0;

		while(i < A.length && j < B.length) {
			if(A[i] <= B[j]) {

				res.add(A[i]);

				i++;
			} else {

				res.add(A[j]);

				j++;
			}
		}

		while(i < A.length) {

			res.add(A[i]);

			i++;
		}
		while(j < B.length) {

			res.add(B[j]);

			j++;
		}

		System.out.println(res);
	}
}
