class Solution {
    public int minInsertions(String s) {
       
      int carj = 0; 
      int open = 0;
  

      for(int i = 0; i < s.length() ; i++){
        if(s.charAt(i) == '('){
            open = open + 1;
        }else{
            if(open == 0){
                carj++;
                open++;
            }
            open--;
            if(i + 1 < s.length() && s.charAt(i +1) == ')'){
                i++;
            }else{
                carj++;
            }
        }
      }
      return carj + open * 2;
    }
}
