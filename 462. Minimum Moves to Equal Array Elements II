class Solution {
    public int minMoves2(int[] nums) {
        
        int moves = 0;

        Arrays.sort(nums);

        int target = nums.length / 2;

        for(int i = 0; i < nums.length ; i++){
            if(nums[i] == nums[target]){
                continue;
            }else if( nums[i] < nums[target]){
                moves = moves + nums[target] - nums[i];
            }else if(nums[i] > nums[target]){
                moves = moves + nums[i] - nums[target];
            }
        }
        return moves;
    }
}
