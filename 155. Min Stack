class MinStack {

    Stack<Integer> stack;
    Stack<Integer> minstack;
    int min;

    public MinStack() {
        
        stack = new Stack<>();
        minstack = new Stack<>();
        min = 99999;
    }
    
    public void push(int val) {
        if(minstack.isEmpty() || val <= minstack.peek()){
            minstack.push(val);
        }
        
        stack.push(val);
    }
    
    public void pop() {

        int removed = stack.pop();

        if(!minstack.isEmpty() && removed == minstack.peek()){
            minstack.pop();
        }
    }
    
    public int top() {
        return stack.peek();
    }
    
    public int getMin() {
        if(!minstack.isEmpty()){
            return minstack.peek();
        }
        return 0;
    }
}
