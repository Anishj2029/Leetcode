
class Solution {
    public int longestMonotonicSubarray(int[] nums) {
        int sicount = 1;
        int sdcount = 1;
        int max = 1;

        for (int i = 1; i < nums.length; i++) {

        
            if (nums[i - 1] < nums[i]) {
                sicount++;
            } else {
                sicount = 1;
            }

            
            if (nums[i - 1] > nums[i]) {
                sdcount++;
            } else {
                sdcount = 1;
            }

            max = Math.max(max, Math.max(sicount, sdcount));
        }

        return max;
    }
}
