class Solution {
    public int missingNumber(int[] nums) {
        int n = nums.length;
        ArrayList<Integer> list = new ArrayList<>();


        for(int i = 0; i < n ; i++){
           list.add(nums[i]);
        }

        for(int i = 1; i <= n ; i++){
            if(!list.contains(i)){
                return i;
            }
        }
        return 0;
    }
}

class Solution {
    public int missingNumber(int[] nums) {
        int n = nums.length;
        int expectedSum = n * (n + 1) / 2;
        int sum = 0;
        for(int i = 0; i < n ; i++){
            sum += nums[i];
        }
        return expectedSum - sum;
    }
}
