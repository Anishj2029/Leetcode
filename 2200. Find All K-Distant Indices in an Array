class Solution {
    public List<Integer> findKDistantIndices(int[] nums, int key, int k) {
        List<Integer> result = new ArrayList<>();

        int n = nums.length;

        for (int i = 0; i < n; i++) {

          
            int start = Math.max(0, i - k);
            int end = Math.min(n - 1, i + k);

            for (int j = start; j <= end; j++) {

                if (nums[j] == key) {
                    result.add(i);
                    break;
                }
            }
        }

        return result;
    }
}
