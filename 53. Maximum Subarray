class Solution {
public:
    int maxSubArray(vector<int>& nums) {
        int n = nums.size();
        int max = -99999;
        int sum = 0;
        int i = 0;
        int j = i;
        int oldsum = 0;

        while(j < n){
            sum = sum + nums[j];

            if (sum < nums[j]){
               sum = nums[j];
            }
            if(max < sum){
                max = sum;
            }
            j++;
        }
        return max;
    }
};

class Solution {
    public int maxSubArray(int[] nums) {
         
         int n = nums.length;
         int maxsum = -99999;
         int sum = 0;
         int slow = 0;
         int fast = slow;

         while(slow < n && fast < n){
            sum = sum + nums[fast];
            if(sum < 0){
                maxsum = Math.max(maxsum, sum);
                slow++;
                sum = 0;
                fast = slow;
            }else{
                fast++;
                maxsum = Math.max(maxsum, sum);
            }
         }
         return maxsum;
    }
}

class Solution {
    public int maxSubArray(int[] nums) {
         
         int sum = 0;
        int maxSum = Integer.MIN_VALUE;

        for (int i = 0; i < nums.length; i++) {
            sum += nums[i];

            maxSum = Math.max(maxSum, sum);

            if (sum < 0) {
                sum = 0;
            }
        }

        return maxSum;
    }
}
