class Solution {
    public boolean check(int[] nums) {
        
        for(int i = 0; i <= nums.length - 2 ; i++){
            if(nums[i] > nums[ i + 1]){
                
                reverse(nums, 0, i);
                reverse(nums, i+1, nums.length - 1);
                return checks(nums);
            }
        }
        return true;
    }
    

    public int[] reverse(int[] nums, int start, int end){
        if(start == end ){
            return nums;
        }
        while(start < end){
            int temp = nums[start];
            nums[start] = nums[end];
            nums[end] = temp;

            start++;
            end--;
        }
        return nums;
    }

    public boolean checks(int[] nums){
        for(int i = 0 ; i <= nums.length - 2; i++){
            if(nums[i] < nums[i + 1]){
                return false;
            }
        }
        return true;
    }
}
