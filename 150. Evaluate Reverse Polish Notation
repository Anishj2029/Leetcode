class Solution {
    public int evalRPN(String[] tokens) {
        Stack<Integer> stack = new Stack<>();
        for(int i = 0; i < tokens.length ; i++){
            if(tokens[i].equals("+")){
                int a = stack.pop();
                int b = stack.pop();
                int result = b + a;
                stack.push(result);

            }else if(tokens[i].equals("-")){
                int a = stack.pop();
                int b = stack.pop();
                int result = b - a;
                stack.push(result);

            }
            else if(tokens[i].equals("*")){
                int a = stack.pop();
                int b = stack.pop();
                int result = b * a;
                stack.push(result);

            }
            else if(tokens[i].equals("/")){
                int a = stack.pop();
                int b = stack.pop();
                int result = b / a;
                stack.push(result);

            }
            else{
                int val = Integer.parseInt(tokens[i]);
                stack.push(val);
                
            }
        }
        int ans = stack.pop();
        return ans;
    }
}
