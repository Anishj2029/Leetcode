class Solution {
    public int longestConsecutive(int[] nums) {

        Arrays.sort(nums);
        int count = 1;
        int maxcount = 1;

        if(nums.length < 1){
            return 0;
        }

        for(int i = 1; i < nums.length ; i++){
            if(nums[i - 1] == nums[i]){
                continue;
            }
            if(nums[i - 1] + 1 == nums[i]){
                count++;
                if(count > maxcount){
                    maxcount = count;
                }
                
            }else{
                count = 1;
            }
           
        }
        return maxcount;
    }
}



class Solution {
    public int longestConsecutive(int[] nums) {
       	HashSet<Integer> set = new HashSet<>();
      
        int maxlen = 0;

        for(int i = 0; i < nums.length; i++){
            set.add(nums[i]);
        }

       for(int i : set){
            
            if(!set.contains(i - 1)){
                int sum  =i;
                int len = 0;
                while(set.contains(sum)){
                len = len + 1;
                maxlen = Math.max(maxlen, len);
                sum++;
                } 
            }
        }
        
        
        return maxlen;
        
    }
}
