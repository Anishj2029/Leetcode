class Solution {
    public int thirdMax(int[] nums) {
       long maximum = Long.MIN_VALUE;
        long second_maximum = Long.MIN_VALUE;
        long third_maximum = Long.MIN_VALUE;

        for (int i = 0; i < nums.length; i++) {

            if (nums[i] > maximum) {
                third_maximum = second_maximum;
                second_maximum = maximum;
                maximum = nums[i];

            } else if (nums[i] > second_maximum && nums[i] != maximum) {
                third_maximum = second_maximum;
                second_maximum = nums[i];

            } else if (nums[i] > third_maximum &&
                       nums[i] != second_maximum &&
                       nums[i] != maximum) {
                third_maximum = nums[i];
            }
        }

        if (third_maximum == Long.MIN_VALUE) {
            return (int) maximum;
        }

        return (int) third_maximum;
    }
}
