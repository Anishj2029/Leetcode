class Solution {
    public int[] limitOccurrences(int[] nums, int k) {
        ArrayList<Integer> ans = new ArrayList<>();

        int i = 0;
        int j = i;
        int count = 0;
        while(j < nums.length){
            if(nums[i] == nums[j]){
                if(count < k){
                    count += 1;
                    ans.add(nums[i]);
                }
            }else{
                i = j;
                j = i - 1;
                count = 0;
            }
            j++;
        }

        int[] result = new int[ans.size()];

        for (int l = 0; l < ans.size(); l++) {
            result[l] = ans.get(l);
        }
    return result;
    }
}
