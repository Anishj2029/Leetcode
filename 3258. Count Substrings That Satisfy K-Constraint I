class Solution {
    public int countKConstraintSubstrings(String s, int k) {
        int substring = 0;

        for(int i = 0; i < s.length() ; i++){
            int j = i;
            int count1 = 0;
            int count0 = 0;
            while(j < s.length()){
                if(s.charAt(j) == '0'){
                    count0 += 1;
                }else if(s.charAt(j) == '1'){
                    count1 += 1;
                }
                if(count0 <= k || count1 <= k){
                    substring += 1;
                    j++;
                }else{
                    break;
                }
            }
        }
        return substring;
    }
}
